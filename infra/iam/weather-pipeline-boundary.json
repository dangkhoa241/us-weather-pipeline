{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:<ACCOUNT_ID>:log-group:/aws/lambda/weather-pipeline-*:*"
    },
    {
      "Sid": "PublishAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-2:<ACCOUNT_ID>:weather-pipeline-*"
    },
    {
      "Sid": "RawArchiveObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::weather-pipeline-raw-*/*"
    },
    {
      "Sid": "ReadConfigParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:us-east-2:<ACCOUNT_ID>:parameter/weather-pipeline/*"
    },
    {
      "Sid": "DecryptSecureStringsViaSsmOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.us-east-2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PublicSignupsSubscribeEmailOnly",
      "Effect": "Allow",
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:sns:us-east-2:<ACCOUNT_ID>:weather-pipeline-*",
      "Condition": {
        "StringEquals": {
          "sns:Protocol": "email"
        }
      }
    },
    {
      "Sid": "PublicSignupsListSubscriptions",
      "Effect": "Allow",
      "Action": "sns:ListSubscriptionsByTopic",
      "Resource": "arn:aws:sns:us-east-2:<ACCOUNT_ID>:weather-pipeline-*"
    },
    {
      "Sid": "PublicSignupsCounters",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:<ACCOUNT_ID>:table/weather-pipeline-*"
    }
  ]
}
