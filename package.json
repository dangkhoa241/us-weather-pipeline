{
  "name": "us-weather-pipeline",
  "version": "1.0.0",
  "description": "US weather data pipeline: weather APIs -> MongoDB -> ClickHouse -> Redis -> API -> dashboard",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "fetch": "node fetchWeather.js",
    "etl:clickhouse": "node etlToClickHouse.js",
    "etl:redis": "node clickhouseToRedis.js",
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "smoke:adapters": "node scripts/smokeAdapters.js",
    "test": "vitest run",
    "seed:locations": "node scripts/seedLocations.js",
    "fetch:watch": "node fetchWeather.js --watch",
    "sync:atlas": "node fetchWeather.js sync-atlas",
    "check:secrets": "node scripts/checkSecrets.js",
    "bench:dashboard": "node scripts/benchDashboard.js",
    "pipeline": "node pipeline.js",
    "loadtest:api": "node scripts/loadTestApi.js",
    "probe:api": "node scripts/probeApi.js"
  },
  "dependencies": {
    "@clickhouse/client": "^1.14.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.5",
    "mongodb": "^7.0.0",
    "node-cron": "^4.6.0",
    "redis": "^4.7.1"
  },
  "license": "ISC",
  "devDependencies": {
    "autocannon": "^8.0.0",
    "vitest": "^5.0.2"
  }
}
