# Copy to .env and adjust. Defaults match docker-compose.yml.

# ---- Pipeline identity -------------------------------------------------------
# Stored in run metadata instead of a person/team name.
PIPELINE_NAME=us-weather-pipeline

# ---- Runtime --------------------------------------------------------------------
# Process time zone. Storage is always UTC; this also makes the cron schedules below run in UTC.
TZ=UTC
LOG_LEVEL=info                     # error | warn | info | debug

# ---- Adapters (which implementation each interface uses) -----------------------
# Local implementations now; AWS options are a later phase.
RAW_STORE=mongo          # mongo | s3 (later)
RAW_ARCHIVE=none         # none | s3: also keep raw API responses in S3 for 30 days (RAW_ARCHIVE_BUCKET below)
CACHE_STORE=redis        # redis | dynamodb (later)
SCHEDULER=node-cron      # node-cron | eventbridge (later)
NOTIFIER=console         # console | sns (Amazon SNS email, docs/SETUP_AWS.md) | discord (later)
WAREHOUSE=clickhouse     # clickhouse | bigquery (later, free tier)

# ---- MongoDB (raw store) ------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=weather
# Legacy collection names used by the old Stage 2 script until it is rewritten.
MONGO_COLLECTION_RAW=weather_raw
MONGO_COLLECTION_ENRICHED=weather_enriched

# ---- ClickHouse (warehouse) ---------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=weather
CLICKHOUSE_PASSWORD=weather
CLICKHOUSE_DB=weather_dw

# ---- Redis (cache) ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_TTL_SEC=3600

# ---- API server ----------------------------------------------------------------
PORT=3000
HOST=127.0.0.1                     # API listens on this machine only; 0.0.0.0 exposes it to the network
API_RATE_LIMIT_PER_MIN=120         # requests per minute per client IP
CORS_ORIGINS=http://localhost:5173 # browser origins allowed to call the API (comma-separated); others get no CORS headers
API_BENCH_MEMORY_LOG=0             # 1 = print memory use every 250 ms (used by scripts/loadTestApi.js)

# ---- External APIs -------------------------------------------------------------
# NWS asks for a User-Agent that identifies the app and a contact (email or URL).
NWS_USER_AGENT="us-weather-pipeline/1.0 (contact: you@example.com)"
HTTP_MAX_RETRIES=4                 # retries on 429/5xx/network errors (exponential backoff)
NWS_MIN_INTERVAL_MS=250            # minimum gap between NWS requests
OPEN_METEO_MIN_INTERVAL_MS=250     # minimum gap between Open-Meteo requests

# ---- Stage 1 settings -----------------------------------------------------------
HISTORY_YEARS=3                    # first history load goes back this many years
ARCHIVE_LAG_DAYS=5                 # the last ~5 archive days are null or model-filled; stop before them
FORECAST_CRON="0 */3 * * *"        # NWS forecast snapshots every 3 hours
ALERTS_CRON="*/15 * * * *"         # NWS active alerts every 15 minutes
HISTORY_CRON="30 6 * * *"          # incremental Open-Meteo history once a day (06:30)
# Open-Meteo forecast API (model comparison next to NWS). Comma-separated model ids; one snapshot per model is
# stored with a `model` field. Prefer single-schedule models (real run time as issued_at); best_match is the baseline.
# gfs_hrrr covers the contiguous US only (other locations are skipped and recorded in pipeline_runs).
OPEN_METEO_FORECAST_MODELS=best_match,gfs_hrrr,gfs_global,ecmwf_ifs025,icon_global
# Every 6 hours, ~30 min after the 00/06/12/18Z runs are on Open-Meteo (ECMWF is last, ~8.2 h after the run;
# GFS ~7 h, ICON ~3.5 h, HRRR ~1.5 h). ~318 weighted calls per run for 53 cities, from the shared budget below.
OPEN_METEO_FORECAST_CRON="40 2,8,14,20 * * *"
# Past model runs from the Open-Meteo Single Runs API (exact issued_at; replaces live collection of these models).
OM_BACKFILL_MODELS=gfs_hrrr,gfs_global,ecmwf_ifs025,icon_global
OM_BACKFILL_DAYS=90                # how far back to fill (Single Runs keeps ~5 months)
OM_BACKFILL_CRON="15 * * * *"      # hourly; each run stops at the budget below and resumes next time
OM_BASELINE_CRON="45 6 * * *"      # best_match baseline (Previous Runs API) for completed days, once a day
# Our own cap on Open-Meteo weighted calls (free tier: 600/min, 5,000/hour, 10,000/day), shared by all modes.
OPEN_METEO_BUDGET_PER_HOUR=2000
OPEN_METEO_BUDGET_PER_DAY=6000
FORECAST_GAP_WARN_HOURS=6          # watcher start: warn + log a gap in pipeline_runs if the newest snapshot is older

# ---- Cloud collection (GitHub Actions → MongoDB Atlas M0), see docs/SETUP_CLOUD_COLLECTION.md ----------
RAW_RETENTION_DAYS=0               # 0 = keep forever (local). Workflows use 7 on Atlas (TTL index on fetched_at)
ATLAS_MONGO_URI=                   # mongodb+srv://... (secret; leave empty to disable sync-atlas)
ATLAS_MONGO_DB=weather
SYNC_ATLAS_CRON="40 5 * * *"       # sync-atlas on its own schedule (only when not watched through the pipeline)
PIPELINE_CRON="50 */3 * * *"       # watcher: pipeline.js = sync-atlas + history → Stage 2 → Stage 3
SYNC_WARN_DAYS=4                   # watcher start: warn + record in pipeline_runs if the last sync is older (Atlas keeps 7 days)

# ---- Notifications --------------------------------------------------------------
# ---- AWS (Stage 6, docs/SETUP_AWS.md). No keys here: the AWS SDK and SAM CLI read them from ~/.aws -------
AWS_PROFILE=weather-runtime        # the app's profile: publish to SNS / write to S3 only (docs/SETUP_AWS.md step 5)
AWS_SHARED_CREDENTIALS_FILE=       # e.g. C:/Users/<you>/.aws-runtime/credentials (runtime keys kept apart from deploy keys)
AWS_CONFIG_FILE=                   # e.g. C:/Users/<you>/.aws-runtime/config
AWS_DEPLOY_PROFILE=weather-dev     # deploy profile in ~/.aws, used only by npm run aws:deploy / aws:teardown
AWS_REGION=us-east-2
SNS_TOPIC_ARN=                     # NOTIFIER=sns: the AlertsTopicArn output of `npm run aws:deploy`
SNS_MIN_LEVEL=warn                 # lowest level that is emailed: info | warn | error (failures + heat alerts = warn/error)
ALERT_EMAIL=                       # SNS email subscription; used only by `npm run aws:deploy`
AWS_STACK_NAME=weather-pipeline
RAW_ARCHIVE_BUCKET=                # RAW_ARCHIVE=s3: the RawArchiveBucketName output of `npm run aws:deploy`
RAW_ARCHIVE_MAX_PUTS_PER_DAY=50    # hard cap on archive uploads (~38 / day expected; S3 free tier 2,000 PUTs / month)
AWS_CONFIG_DIR=                    # e.g. C:/Users/<you>/.aws-runtime: folder with ONLY the weather-runtime profile, mounted read-only into the Docker fetcher

# Used when NOTIFIER=discord. Keep the real URL in .env only; it is a secret.
DISCORD_WEBHOOK_URL=
