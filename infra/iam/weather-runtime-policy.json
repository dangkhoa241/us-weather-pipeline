{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-2:<ACCOUNT_ID>:weather-pipeline-alerts"
    },
    {
      "Sid": "Part2WriteRawArchive",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::weather-pipeline-raw-<ACCOUNT_ID>/*"
    }
  ]
}
